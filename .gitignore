# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.ruff_cache

# Virtual environments
.venv

# Local session state, never published: SESSION.md, SESSION.next.md, archive/.
# The protocol, the snapshot template and the helper script are tracked.
/.handoff/*
!/.handoff/README.md
!/.handoff/TEMPLATE.md
!/.handoff/handoff.py
!/.handoff/test_handoff.py

# Sandbox of the tutor mode "sandbox": demo files that never touch project code
/.sandbox/

# Worktrees that Claude Code creates for isolated sessions
/.claude/worktrees/
